---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<div class="space-y-3">
  {items.map((item) => (
    <details class="group bg-white border border-slate-200 rounded-xl px-5 py-4 open:shadow-sm">
      <summary class="cursor-pointer font-semibold text-brand-900 list-none flex justify-between items-center gap-4">
        {item.q}
        <span class="text-brand-600 text-xl leading-none group-open:rotate-45 transition-transform">+</span>
      </summary>
      <p class="mt-3 text-slate-600 text-sm leading-relaxed">{item.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
