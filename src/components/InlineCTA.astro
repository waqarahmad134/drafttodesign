---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to start your project?',
  text = 'Get a free quote within 24 hours. No obligation.',
} = Astro.props;
---

<div class="not-prose bg-brand-50 border border-brand-100 rounded-2xl px-6 py-8 my-10 text-center">
  <h3 class="text-xl font-bold text-brand-900 mb-2">{title}</h3>
  <p class="text-slate-600 text-sm mb-5">{text}</p>
  <div class="flex flex-col sm:flex-row gap-3 justify-center">
    <a href="#quote-form" class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">
      Get a Free Quote
    </a>
    <a href="https://wa.me/13094025405" class="border border-brand-300 text-brand-700 font-semibold px-6 py-2.5 rounded-lg hover:bg-brand-100 transition text-sm">
      WhatsApp Us
    </a>
  </div>
</div>
