---
const nav = [
  { label: 'Services', href: '/#services' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Process', href: '/process/' },
  { label: 'FAQ', href: '/faq/' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 font-extrabold text-xl text-brand-900">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="28" height="28" rx="7" fill="#2f6bff" />
          <path d="M10 22V10h6.5a5.5 5.5 0 0 1 0 11H12" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M21 22v-3.5" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
        </svg>
        DraftToDesign
      </a>
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-700">
        {nav.map((item) => (
          <a href={item.href} class="hover:text-brand-600 transition">{item.label}</a>
        ))}
      </nav>
      <div class="flex items-center gap-3">
        <a
          href="/contact/"
          class="hidden sm:inline-flex bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition"
        >
          Get a Quote
        </a>
      </div>
    </div>
  </div>
</header>
