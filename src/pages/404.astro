---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page Not Found | DraftToDesign" description="The page you are looking for does not exist." noindex={true}>
  <Header slot="header" />
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-7xl font-extrabold text-brand-600 mb-4">404</p>
    <h1 class="text-3xl font-bold text-brand-900 mb-4">This page wandered off the plan</h1>
    <p class="text-slate-600 mb-8">The page you are looking for does not exist or was moved.</p>
    <a href="/" class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-8 py-3 rounded-lg transition">Back to Home</a>
  </div>
  <Footer slot="footer" />
</BaseLayout>
