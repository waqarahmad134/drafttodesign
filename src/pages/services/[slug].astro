---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CTABand from '../../components/CTABand.astro';
import InlineCTA from '../../components/InlineCTA.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id.replace(/\.md$/, '') }, props: { service: s } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const allServices = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((s) => s.id !== service.id);
const slugOf = (e: { id: string }) => e.id.replace(/\.md$/, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  provider: { '@type': 'ProfessionalService', name: 'DraftToDesign', url: 'https://drafttodesign.com' },
  areaServed: { '@type': 'Country', name: 'United States' },
  description: service.data.description,
};
---

<BaseLayout
  title={service.data.metaTitle}
  description={service.data.metaDescription}
  schema={schema}
>
  <Header slot="header" />

  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <nav class="text-sm text-slate-500 mb-6">
        <a href="/" class="hover:text-brand-600">Home</a> <span class="mx-1">/</span>
        <span class="text-slate-700">{service.data.shortTitle}</span>
      </nav>
      <h1 class="text-4xl font-extrabold text-brand-900 mb-4">{service.data.title}</h1>
      <p class="text-lg text-slate-600 mb-6">{service.data.description}</p>
      <div class="flex flex-wrap gap-4 text-sm mb-8">
        <span class="bg-white border border-slate-200 rounded-lg px-4 py-2">From <strong class="text-brand-700">{service.data.priceFrom}</strong></span>
        <span class="bg-white border border-slate-200 rounded-lg px-4 py-2">Delivery: <strong>{service.data.deliveryTime}</strong></span>
      </div>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#quote-form" class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-8 py-3 rounded-lg transition text-center">
          Get a Free Quote
        </a>
        <a href="https://wa.me/923044719600?text=drafttodesign.com%3A%20Hi!%20I%20want%20a%20free%20quote%20for%20my%20project." class="border-2 border-brand-600 text-brand-700 font-semibold px-8 py-3 rounded-lg hover:bg-brand-50 transition text-center">
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid lg:grid-cols-3 gap-10">
    <article class="lg:col-span-2 prose prose-slate max-w-none prose-headings:text-brand-900 prose-a:text-brand-600">
      <Content />
      <InlineCTA title={`Need ${service.data.shortTitle.toLowerCase()} for your project?`} text="Send your requirements and get a free, no-obligation quote within 24 hours." />
    </article>
    <aside>
      <div class="sticky top-24">
        <QuoteForm compact />
      </div>
    </aside>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-extrabold text-brand-900 mb-6">Other services</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-4">
      {allServices.map((s) => (
        <a href={`/services/${slugOf(s)}/`} class="bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg hover:border-brand-300 transition">
          <h3 class="font-bold text-brand-900 mb-2">{s.data.title}</h3>
          <p class="text-sm text-slate-600">From {s.data.priceFrom} - {s.data.deliveryTime}</p>
        </a>
      ))}
    </div>
    <CTABand />
  </div>

  <Footer slot="footer" />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .prose h2 { font-size: 1.5rem; font-weight: 700; margin: 1.75rem 0 0.75rem; }
  .prose h3 { font-size: 1.2rem; font-weight: 600; margin: 1.5rem 0 0.5rem; }
  .prose p, .prose ul { margin-bottom: 1rem; line-height: 1.7; color: #475569; }
  .prose ul { list-style: disc; padding-left: 1.5rem; }
  .prose blockquote { border-left: 4px solid #2f6bff; padding-left: 1rem; font-style: italic; color: #475569; margin: 1.5rem 0; }
  .prose strong { color: #0e1e4a; }
</style>
