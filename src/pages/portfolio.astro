---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABand from '../components/CTABand.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const categories = ['All', '3D Rendering', 'Interior Design', 'Exterior Design', 'Floor Plans'];

const items = [
  { src: '/portfolio/house-exterior-dusk.webp', title: 'Luxury Home at Dusk', cat: '3D Rendering', alt: 'Photorealistic 3D render of a luxury modern house exterior at dusk' },
  { src: '/portfolio/living-room-render.webp', title: 'Modern Living Room', cat: '3D Rendering', alt: 'Photorealistic 3D render of a modern double-height living room' },
  { src: '/portfolio/kitchen-interior.webp', title: 'Modern Kitchen Concept', cat: 'Interior Design', alt: 'Interior design concept render of a modern kitchen with marble island' },
  { src: '/portfolio/master-bedroom.webp', title: 'Master Bedroom Retreat', cat: 'Interior Design', alt: 'Interior design concept render of a cozy master bedroom' },
  { src: '/portfolio/bathroom-interior.webp', title: 'Spa-Like Bathroom', cat: 'Interior Design', alt: 'Interior design concept render of a modern spa-like bathroom' },
  { src: '/portfolio/facade-landscaping.webp', title: 'Facade Makeover', cat: 'Exterior Design', alt: 'Exterior design render of a house facade with new landscaping' },
  { src: '/portfolio/backyard-pool.webp', title: 'Backyard with Pool', cat: 'Exterior Design', alt: 'Landscaping design render of a backyard with pool and pergola' },
  { src: '/portfolio/floor-plan-3bed.webp', title: '3-Bedroom Floor Plan', cat: 'Floor Plans', alt: 'Dimensioned 2D floor plan of a 3-bedroom single-story house' },
];
---

<BaseLayout
  title="Portfolio | DraftToDesign - Our Design Work"
  description="Browse DraftToDesign portfolio: 3D renders, interior design concepts, exterior and landscaping visuals, and floor plans for clients across the USA."
>
  <Header slot="header" />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h1 class="text-4xl font-extrabold text-brand-900 mb-3">Portfolio</h1>
    <p class="text-lg text-slate-600 mb-10">A selection of our recent work for clients across the USA.</p>

    <div class="flex flex-wrap gap-3 mb-10" id="filters">
      {categories.map((c, i) => (
        <button
          data-filter={c}
          class={`px-5 py-2 rounded-full text-sm font-medium border transition ${i === 0 ? 'bg-brand-600 text-white border-brand-600' : 'bg-white text-slate-600 border-slate-300 hover:border-brand-400'}`}
        >
          {c}
        </button>
      ))}
    </div>

    <div id="gallery" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <figure data-category={item.cat} class="portfolio-item group bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={item.src} alt={item.alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          </div>
          <figcaption class="p-4 flex items-center justify-between">
            <span class="font-semibold text-brand-900">{item.title}</span>
            <span class="text-xs bg-brand-50 text-brand-700 px-3 py-1 rounded-full font-medium">{item.cat}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="text-sm text-slate-500 mt-8 text-center">Sample visuals shown. Your project gets the same photorealistic treatment.</p>

    <CTABand />
  </div>
  <Footer slot="footer" />
  <WhatsAppFloat />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('#filters button');
  const items = document.querySelectorAll('.portfolio-item');
  const active = 'px-5 py-2 rounded-full text-sm font-medium border transition bg-brand-600 text-white border-brand-600';
  const idle = 'px-5 py-2 rounded-full text-sm font-medium border transition bg-white text-slate-600 border-slate-300 hover:border-brand-400';
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => (b.className = idle));
      btn.className = active;
      const f = btn.getAttribute('data-filter');
      items.forEach((el) => {
        const show = f === 'All' || el.getAttribute('data-category') === f;
        el.classList.toggle('hidden', !show);
      });
    });
  });
</script>
