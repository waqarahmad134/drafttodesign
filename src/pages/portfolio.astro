---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABand from '../components/CTABand.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const categories = ['All', '3D Rendering', 'Interior Design', 'Exterior Design', 'Floor Plans'];

const items = [
  { src: '/portfolio/house-exterior-dusk.webp', title: 'Luxury Home at Dusk', cat: '3D Rendering', alt: 'Photorealistic 3D render of a luxury modern house exterior at dusk' },
  { src: '/portfolio/living-room-render.webp', title: 'Modern Living Room', cat: '3D Rendering', alt: 'Photorealistic 3D render of a modern double-height living room' },
  { src: '/portfolio/kitchen-interior.webp', title: 'Modern Kitchen Concept', cat: 'Interior Design', alt: 'Interior design concept render of a modern kitchen with marble island' },
  { src: '/portfolio/master-bedroom.webp', title: 'Master Bedroom Retreat', cat: 'Interior Design', alt: 'Interior design concept render of a cozy master bedroom' },
  { src: '/portfolio/bathroom-interior.webp', title: 'Spa-Like Bathroom', cat: 'Interior Design', alt: 'Interior design concept render of a modern spa-like bathroom' },
  { src: '/portfolio/facade-landscaping.webp', title: 'Facade Makeover', cat: 'Exterior Design', alt: 'Exterior design render of a house facade with new landscaping' },
  { src: '/portfolio/backyard-pool.webp', title: 'Backyard with Pool', cat: 'Exterior Design', alt: 'Landscaping design render of a backyard with pool and pergola' },
  { src: '/portfolio/floor-plan-3bed.webp', title: '3-Bedroom Floor Plan', cat: 'Floor Plans', alt: 'Dimensioned 2D floor plan of a 3-bedroom single-story house' },
];
---

<BaseLayout
  title="Portfolio | DraftToDesign - Our Design Work"
  description="Browse DraftToDesign portfolio: 3D renders, interior design concepts, exterior and landscaping visuals, and floor plans for clients across the USA."
>
  <Header slot="header" />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h1 class="text-4xl font-extrabold text-brand-900 mb-3">Portfolio</h1>
    <p class="text-lg text-slate-600 mb-10">A selection of our recent work for clients across the USA.</p>

    <div class="flex flex-wrap gap-3 mb-10" id="filters">
      {categories.map((c, i) => (
        <button
          data-filter={c}
          class={`px-5 py-2 rounded-full text-sm font-medium border transition ${i === 0 ? 'bg-brand-600 text-white border-brand-600' : 'bg-white text-slate-600 border-slate-300 hover:border-brand-400'}`}
        >
          {c}
        </button>
      ))}
    </div>

    <div id="gallery" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <figure
          data-category={item.cat}
          data-src={item.src}
          data-title={item.title}
          data-alt={item.alt}
          tabindex="0"
          class="portfolio-item group bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition cursor-zoom-in"
        >
          <div class="aspect-[4/3] overflow-hidden relative">
            <img src={item.src} alt={item.alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <span class="absolute inset-0 bg-brand-900/0 group-hover:bg-brand-900/25 transition flex items-center justify-center">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition drop-shadow-lg">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.5" y2="16.5" />
                <line x1="11" y1="8" x2="11" y2="14" />
                <line x1="8" y1="11" x2="14" y2="11" />
              </svg>
            </span>
          </div>
          <figcaption class="p-4 flex items-center justify-between">
            <span class="font-semibold text-brand-900">{item.title}</span>
            <span class="text-xs bg-brand-50 text-brand-700 px-3 py-1 rounded-full font-medium">{item.cat}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* Lightbox gallery */}
    <div id="lightbox" class="hidden fixed inset-0 z-[70] bg-black/90 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Image gallery">
      <button id="lb-close" class="absolute top-4 right-4 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition" aria-label="Close gallery">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
      <button id="lb-prev" class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition" aria-label="Previous image">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <button id="lb-next" class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition" aria-label="Next image">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
      <div class="h-full flex flex-col items-center justify-center px-4 sm:px-16 py-16">
        <img id="lb-img" src="" alt="" class="max-h-[75vh] max-w-full rounded-xl shadow-2xl object-contain" />
        <div class="mt-4 text-center">
          <p id="lb-title" class="text-white font-semibold text-lg"></p>
          <p id="lb-counter" class="text-white/60 text-sm mt-1"></p>
        </div>
      </div>
    </div>

    <p class="text-sm text-slate-500 mt-8 text-center">Sample visuals shown. Your project gets the same photorealistic treatment.</p>

    <CTABand />
  </div>
  <Footer slot="footer" />
  <WhatsAppFloat />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('#filters button');
  const items = Array.from(document.querySelectorAll('.portfolio-item'));
  const active = 'px-5 py-2 rounded-full text-sm font-medium border transition bg-brand-600 text-white border-brand-600';
  const idle = 'px-5 py-2 rounded-full text-sm font-medium border transition bg-white text-slate-600 border-slate-300 hover:border-brand-400';
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => (b.className = idle));
      btn.className = active;
      const f = btn.getAttribute('data-filter');
      items.forEach((el) => {
        const show = f === 'All' || el.getAttribute('data-category') === f;
        el.classList.toggle('hidden', !show);
      });
    });
  });

  // Lightbox gallery with carousel (navigates within the currently visible / filtered items)
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbTitle = document.getElementById('lb-title');
  const lbCounter = document.getElementById('lb-counter');
  let visible = [];
  let current = 0;

  const visibleItems = () => items.filter((el) => !el.classList.contains('hidden'));

  function show(i) {
    visible = visibleItems();
    if (!visible.length) return;
    current = (i + visible.length) % visible.length;
    const el = visible[current];
    lbImg.src = el.getAttribute('data-src');
    lbImg.alt = el.getAttribute('data-alt');
    lbTitle.textContent = el.getAttribute('data-title');
    lbCounter.textContent = `${current + 1} / ${visible.length}`;
  }

  function open(el) {
    show(visibleItems().indexOf(el));
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.classList.add('hidden');
    document.body.style.overflow = '';
  }

  items.forEach((el) => {
    el.addEventListener('click', () => open(el));
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(el); }
    });
  });

  document.getElementById('lb-close').addEventListener('click', close);
  document.getElementById('lb-prev').addEventListener('click', (e) => { e.stopPropagation(); show(current - 1); });
  document.getElementById('lb-next').addEventListener('click', (e) => { e.stopPropagation(); show(current + 1); });
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
