---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABand from '../components/CTABand.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const plans = [
  {
    name: 'Draft Basic',
    price: 'from $99',
    tag: '2D essentials',
    features: ['Dimensioned 2D floor plan', 'PDF + CAD (DWG) files', '3-5 day delivery', '2 revision rounds', 'Email support'],
  },
  {
    name: '3D Standard',
    price: 'from $199',
    tag: 'Most popular',
    highlight: true,
    features: ['Accurate 3D model (SKP/FBX)', 'Photorealistic renders (4K)', '5-10 day delivery', '2 revision rounds', 'WhatsApp + email support'],
  },
  {
    name: 'Design Premium',
    price: 'from $299',
    tag: 'Full concept',
    features: ['Complete interior or exterior concept', 'Concept board + material palette', 'Photorealistic renders (4K)', '7-14 day delivery', '2 revision rounds', 'Priority support'],
  },
];
---

<BaseLayout
  title="Pricing | DraftToDesign - Fixed, Transparent Design Pricing"
  description="Simple fixed pricing: floor plans from $99, 3D renders from $79, 3D models from $199, design concepts from $249-$299. No hourly billing, quote before we start."
>
  <Header slot="header" />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h1 class="text-4xl font-extrabold text-brand-900 text-center mb-3">Simple, fixed pricing</h1>
    <p class="text-slate-600 text-center max-w-2xl mx-auto mb-12">Every project gets a fixed quote before we start. No hourly billing, no surprises.</p>
    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {plans.map((p) => (
        <div class={`rounded-3xl border p-8 ${p.highlight ? 'border-brand-600 shadow-xl ring-2 ring-brand-600/20 bg-brand-50/50' : 'border-slate-200 bg-white'}`}>
          <p class="text-sm font-semibold text-brand-600 uppercase tracking-wide mb-2">{p.tag}</p>
          <h2 class="text-2xl font-extrabold text-brand-900 mb-1">{p.name}</h2>
          <p class="text-3xl font-extrabold text-brand-700 mb-6">{p.price}</p>
          <ul class="space-y-3 text-sm text-slate-600 mb-8">
            {p.features.map((f) => (
              <li class="flex gap-2"><span class="text-brand-600 font-bold">✓</span>{f}</li>
            ))}
          </ul>
          <a href="/contact/" class={`block text-center font-semibold py-3 rounded-lg transition ${p.highlight ? 'bg-brand-600 hover:bg-brand-700 text-white' : 'border-2 border-brand-600 text-brand-700 hover:bg-brand-50'}`}>
            Get a Quote
          </a>
        </div>
      ))}
    </div>
    <div class="max-w-3xl mx-auto mt-12 bg-slate-50 border border-slate-200 rounded-2xl p-6 text-sm text-slate-600">
      <p class="font-semibold text-brand-900 mb-2">Single renders from $79</p>
      <p>Need just one image? Individual photorealistic renders start at $79 each. Contact us with your project details for an exact fixed quote within 24 hours.</p>
    </div>
    <CTABand />
  </div>
  <Footer slot="footer" />
  <WhatsAppFloat />
</BaseLayout>
