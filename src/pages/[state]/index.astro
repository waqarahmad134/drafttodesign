---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTABand from '../../components/CTABand.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const states = await getCollection('states');
  const cities = await getCollection('cities');
  const slugOf = (e: { id: string }) => e.id.replace(/\.md$/, '');
  return states.map((st) => ({
    params: { state: slugOf(st) },
    props: {
      state: st,
      stateSlug: slugOf(st),
      cities: cities.filter((c) => c.data.stateSlug === slugOf(st)),
    },
  }));
}

const { state, stateSlug, cities } = Astro.props;
const { Content } = await render(state);
---

<BaseLayout title={state.data.metaTitle} description={state.data.metaDescription}>
  <Header slot="header" />

  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <nav class="text-sm text-slate-500 mb-6">
        <a href="/" class="hover:text-brand-600">Home</a> <span class="mx-1">/</span>
        <span class="text-slate-700">{state.data.stateName}</span>
      </nav>
      <h1 class="text-4xl font-extrabold text-brand-900 mb-4">{state.data.title}</h1>
      <p class="text-lg text-slate-600">{state.data.description}</p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <article class="prose prose-slate max-w-none prose-headings:text-brand-900 prose-a:text-brand-600">
      <Content />
    </article>

    <h2 class="text-2xl font-extrabold text-brand-900 mt-12 mb-6">Cities in {state.data.stateName}</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {cities.map((c) => (
        <a href={`/${stateSlug}/${c.id.replace(/\.md$/, '')}/`} class="bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg hover:border-brand-300 transition">
          <h3 class="font-bold text-brand-900 mb-1">{c.data.cityName}, {c.data.stateAbbr}</h3>
          <p class="text-sm text-slate-600">Floor plans, drafting, 3D modeling, rendering, interior and exterior design</p>
        </a>
      ))}
    </div>

    <CTABand />
  </div>

  <Footer slot="footer" />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .prose h2 { font-size: 1.5rem; font-weight: 700; margin: 1.75rem 0 0.75rem; }
  .prose p, .prose ul { margin-bottom: 1rem; line-height: 1.7; color: #475569; }
  .prose ul { list-style: disc; padding-left: 1.5rem; }
  .prose strong { color: #0e1e4a; }
</style>
